DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Auth.js (Google sign-in, open to any Google account)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only needed to run the one-off `npm run db:backfill-owner` migration script
# (scripts/backfill-owner.ts) — not read anywhere else.
# ALLOWED_EMAIL="your-email@example.com"

# AI-assisted form filling
# Development: keep AI_PROVIDER="mock" — no external request is made and no API key is required.
AI_PROVIDER="mock"
AI_MOCK_DELAY_MS="0"

# Production: set AI_PROVIDER="openai" and provide a server-only API key.
# OPENAI_API_KEY="sk-..."
OPENAI_API_KEY=""
